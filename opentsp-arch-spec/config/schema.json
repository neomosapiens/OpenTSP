  "x-opentsp-why": "sram.bank_bit must be the upper-most address bit: log2(words_per_slice) - 1 (7 for 256 words, 12 for 8192, 15 for 65536)",
  "x-opentsp-relations": [
    {
      "a": "sram.bank_bit",
      "op": "<",
      "b": "sram.addr_bits",
      "offset": 0,
      "why": "a slice has at most 2^addr_bits words, so the bank bit (log2(words_per_slice) - 1) is below addr_bits"
    },
    {
      "a": "layout.c2c_rx_gap",
      "op": "<",
      "b": "layout.mem_up_gap_base",
      "offset": 1,
      "quads": -1,
      "why": "the C2C receiver is outside the last MEM quad on the inward row"
    },
    {
      "a": "layout.mem_up_gap_base",
      "op": "<",
      "b": "layout.vxm_gap",
      "offset": 0,
      "why": "MEM (inward) is between the C2C receiver and the VXM"
    },
    {
      "a": "layout.vxm_gap",
      "op": "<",
      "b": "layout.mem_down_gap_base",
      "offset": 0,
      "why": "the VXM is between the inward and outward MEM gaps"
    },
    {
      "a": "layout.mem_down_gap_base",
      "op": "<",
      "b": "layout.c2c_tx_gap",
