// Exact IEEE 754 binary16/binary32 arithmetic (no external FP library).

// IEEE 754 binary16 / binary32 arithmetic, defined exactly.
// A finite value is sign * mag * 2^e with mag, e integers. Operations compute the
// exact result and round once (round-to-nearest-even). NaN results are canonical.

// ieee: the top exponent code is reserved for infinities and NaNs (binary16, binary32, e5m2). A format with
// ieee = false (e4m3) has no infinity: only the all-ones pattern is NaN, the top exponent code is an
// ordinary one, and an overflow saturates to the largest finite value (microarchitecture.md sec. 5, FP8).
struct fmt = { mbits : int, ebits : int, bias : int, emin : int, width : int, ieee : bool }

let FMT16 : fmt = struct { mbits = 10, ebits = 5, bias = 15, emin = -14, width = 16, ieee = true }
let FMT32 : fmt = struct { mbits = 23, ebits = 8, bias = 127, emin = -126, width = 32, ieee = true }
let FMT_E5M2 : fmt = struct { mbits = 2, ebits = 5, bias = 15, emin = -14, width = 8, ieee = true }
let FMT_E4M3 : fmt = struct { mbits = 3, ebits = 4, bias = 7, emin = -6, width = 8, ieee = false }
// bfloat16: the top 16 bits of a binary32 (8 exponent bits, 7 fraction bits); an extension type (microarchitecture.md sec. 5, bf16).
let FMT_BF16 : fmt = struct { mbits = 7, ebits = 8, bias = 127, emin = -126, width = 16, ieee = true }

enum fclass = FZero | FFinite | FInf | FNaN

function fclass_eq(a : fclass, b : fclass) -> bool = match (a, b) {
  (FZero, FZero) => true, (FFinite, FFinite) => true,
  (FInf, FInf) => true, (FNaN, FNaN) => true, _ => false
}

overload operator == = {fclass_eq}

struct fval = { cls : fclass, neg : bool, mag : int, e : int }

// floor(log2(n)) for n >= 1, exact for n < 2^16384 (the one-bit-at-a-time loop it replaces is exact for every n). A shift
// cascade without a loop: the prover backends and the SMT backend translate it, the loop they do not. The largest argument of
// the model is the integer square root input of the 4096-bit Ziv cap of transcendental.sail (about 2^8225); the binary32
// alignments of fp.sail reach about 2^277. Two forms of one cascade: the proof build (`-D OPENTSP_PROOF_BUILD`) takes the
// flat one, because the SMT backend does not finish an obligation with constant arguments through the nested one; every
// other build takes the nested one, because the C backend parses every decimal literal it compares against on every call: a
// value below 2^64 (every binary16 and binary32 alignment but the widest, about 2^277) meets one 20-digit literal before its
// 32-bit step, a value below 2^512 meets literals of at most 155 digits, and only the integer square root input of the 4096-bit
// Ziv cap meets the long ones. test/export/ilog2_equiv.sh checks both forms against the loop.
$ifdef OPENTSP_PROOF_BUILD
function ilog2(n : int) -> int = {
  var k : int = 0;
  var m : int = n;
  if m >=  then { m = tdiv_int(m, ); k = k + 8192 };
  if m >=  then { m = tdiv_int(m, ); k = k + 4096 };
  if m >=  then { m = tdiv_int(m, ); k = k + 2048 };
  if m >=  then { m = tdiv_int(m, ); k = k + 1024 };
  if m >= 13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096 then { m = tdiv_int(m, 13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096); k = k + 512 };
  if m >= 115792089237316195423570985008687907853269984665640564039457584007913129639936 then { m = tdiv_int(m, 115792089237316195423570985008687907853269984665640564039457584007913129639936); k = k + 256 };
  if m >= 340282366920938463463374607431768211456 then { m = tdiv_int(m, 340282366920938463463374607431768211456); k = k + 128 };
  if m >= 18446744073709551616 then { m = tdiv_int(m, 18446744073709551616); k = k + 64 };
  if m >= 4294967296 then { m = tdiv_int(m, 4294967296); k = k + 32 };
  if m >= 65536 then { m = tdiv_int(m, 65536); k = k + 16 };
  if m >= 256 then { m = tdiv_int(m, 256); k = k + 8 };
  if m >= 16 then { m = tdiv_int(m, 16); k = k + 4 };
  if m >= 4 then { m = tdiv_int(m, 4); k = k + 2 };
  if m >= 2 then { k = k + 1 };
  k
}
$else
function ilog2(n : int) -> int = {
  var k : int = 0;
  var m : int = n;
  if m >= 18446744073709551616 then {
    if m >= 340282366920938463463374607431768211456 then {
      if m >= 13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096 then {
        if m >=  then {
          if m >=  then { m = tdiv_int(m, ); k = k + 8192 };
          if m >=  then { m = tdiv_int(m, ); k = k + 4096 };
          if m >=  then { m = tdiv_int(m, ); k = k + 2048 };
          if m >=  then { m = tdiv_int(m, ); k = k + 1024 }
        };
        if m >= 13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096 then { m = tdiv_int(m, 13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096); k = k + 512 }
      };
      if m >= 115792089237316195423570985008687907853269984665640564039457584007913129639936 then { m = tdiv_int(m, 115792089237316195423570985008687907853269984665640564039457584007913129639936); k = k + 256 };
      if m >= 340282366920938463463374607431768211456 then { m = tdiv_int(m, 340282366920938463463374607431768211456); k = k + 128 }
    };
    if m >= 18446744073709551616 then { m = tdiv_int(m, 18446744073709551616); k = k + 64 }
  };
  if m >= 4294967296 then { m = tdiv_int(m, 4294967296); k = k + 32 };
  if m >= 65536 then { m = tdiv_int(m, 65536); k = k + 16 };
  if m >= 256 then { m = tdiv_int(m, 256); k = k + 8 };
  if m >= 16 then { m = tdiv_int(m, 16); k = k + 4 };
  if m >= 4 then { m = tdiv_int(m, 4); k = k + 2 };
  if m >= 2 then { k = k + 1 };
  k
}
$endif

function pow2i(n : int) -> int = if n <= 0 then 1 else pow2(n)

function field(x : bits(32), lsb : int, n : int) -> int =
  tdiv_int(unsigned(x), pow2i(lsb)) - tdiv_int(unsigned(x), pow2i(lsb + n)) * pow2i(n)

function canon_nan(f : fmt) -> bits(32) =
  if f.width == 8 then (if f.ieee then 0x0000007E else 0x0000007F)
  else if f.width == 16 then (if f.ebits == 8 then 0x00007FC0 else 0x00007E00) else 0x7FC00000

// The infinity of an IEEE format. e4m3 has none: its "infinity" is the saturation value, the largest
// finite magnitude 448 (0x7E), which an overflow and a conversion of an infinity give.
function inf_bits(f : fmt, neg : bool) -> bits(32) =
  if f.width == 8 then (if f.ieee then (if neg then 0x000000FC else 0x0000007C) else (if neg then 0x000000FE else 0x0000007E))
  else if f.width == 16 then (if f.ebits == 8 then (if neg then 0x0000FF80 else 0x00007F80) else (if neg then 0x0000FC00 else 0x00007C00))
  else (if neg then 0xFF800000 else 0x7F800000)

function zero_bits(f : fmt, neg : bool) -> bits(32) =
  if f.width == 8 then (if neg then 0x00000080 else 0x00000000)
  else if f.width == 16 then (if neg then 0x00008000 else 0x00000000)
  else (if neg then 0x80000000 else 0x00000000)

function fdecode(f : fmt, x : bits(32)) -> fval = {
  let neg = field(x, f.width - 1, 1) == 1;
  let ex = field(x, f.mbits, f.ebits);
  let fr = field(x, 0, f.mbits);
  if f.ieee & ex == pow2i(f.ebits) - 1 then
    struct { cls = if fr == 0 then FInf else FNaN, neg = neg, mag = 0, e = 0 }
  else if (not(f.ieee)) & ex == pow2i(f.ebits) - 1 & fr == pow2i(f.mbits) - 1 then
    struct { cls = FNaN, neg = neg, mag = 0, e = 0 }
  else if ex == 0 & fr == 0 then
    struct { cls = FZero, neg = neg, mag = 0, e = 0 }
  else if ex == 0 then
    struct { cls = FFinite, neg = neg, mag = fr, e = f.emin - f.mbits }
  else
    struct { cls = FFinite, neg = neg, mag = fr + pow2i(f.mbits), e = ex - f.bias - f.mbits }
}

function is_nan(f : fmt, x : bits(32)) -> bool = fdecode(f, x).cls == FNaN

// Round neg * mag * 2^e (mag >= 0) to format f, RNE.
function fround(f : fmt, neg : bool, mag : int, e : int) -> bits(32) = {
  if mag == 0 then zero_bits(f, neg) else {
    let p = ilog2(mag);
    let ee = if p + e < f.emin then f.emin else p + e;
    let q = ee - f.mbits;
    var m : int = 0;
    if e >= q then m = mag * pow2i(e - q) else {
      let d = pow2i(q - e);
      let lo = tdiv_int(mag, d);
      let rem = mag - lo * d;
      let half = tdiv_int(d, 2);
      if rem > half | (rem == half & tmod_int(lo, 2) == 1) then m = lo + 1 else m = lo
    };
    var ex : int = ee;
    if m == pow2i(f.mbits + 1) then { m = tdiv_int(m, 2); ex = ex + 1 };
    if m == 0 then zero_bits(f, neg)
    else if m < pow2i(f.mbits) then {
      // subnormal: biased exponent 0
      let v = (if neg then pow2i(f.width - 1) else 0) + m;
      get_slice_int(32, v, 0)
    } else if f.ieee & ex + f.bias >= pow2i(f.ebits) - 1 then inf_bits(f, neg)
    else if (not(f.ieee)) & (ex + f.bias > pow2i(f.ebits) - 1 | (ex + f.bias == pow2i(f.ebits) - 1 & m - pow2i(f.mbits) == pow2i(f.mbits) - 1))
    then inf_bits(f, neg)      // e4m3: saturate to 448 (the all-ones fraction is NaN)
    else {
      let v = (if neg then pow2i(f.width - 1) else 0) + (ex + f.bias) * pow2i(f.mbits) + (m - pow2i(f.mbits));
      get_slice_int(32, v, 0)
    }
  }
}

// Exact signed value as (signed integer, exponent).
function fadd_core(f : fmt, a : fval, b : fval, negate_b : bool) -> bits(32) = {
  let bneg : bool = if negate_b then not_bool(b.neg) else b.neg;
  if a.cls == FNaN | b.cls == FNaN then canon_nan(f)
  else if a.cls == FInf & b.cls == FInf then
    (if a.neg == bneg then inf_bits(f, a.neg) else canon_nan(f))
  else if a.cls == FInf then inf_bits(f, a.neg)
  else if b.cls == FInf then inf_bits(f, bneg)
  else if a.cls == FZero & b.cls == FZero then zero_bits(f, a.neg & bneg)
  else {
    let e = if a.cls == FZero then b.e else if b.cls == FZero then a.e
            else (if a.e < b.e then a.e else b.e);
    let av = if a.cls == FZero then 0 else a.mag * pow2i(a.e - e);
    let bv = if b.cls == FZero then 0 else b.mag * pow2i(b.e - e);
    let s = (if a.neg then 0 - av else av) + (if bneg then 0 - bv else bv);
    if s == 0 then zero_bits(f, false)   // RNE: exact zero sum of opposite signs is +0
    else if s < 0 then fround(f, true, 0 - s, e)
    else fround(f, false, s, e)
  }
}

function fp_add(f : fmt, x : bits(32), y : bits(32)) -> bits(32) =
  fadd_core(f, fdecode(f, x), fdecode(f, y), false)

function fp_sub(f : fmt, x : bits(32), y : bits(32)) -> bits(32) =
  fadd_core(f, fdecode(f, x), fdecode(f, y), true)

function fp_mul(f : fmt, x : bits(32), y : bits(32)) -> bits(32) = {
  let a = fdecode(f, x);
  let b = fdecode(f, y);
  let neg = a.neg != b.neg;
  if a.cls == FNaN | b.cls == FNaN then canon_nan(f)
  else if (a.cls == FInf & b.cls == FZero) | (a.cls == FZero & b.cls == FInf) then canon_nan(f)
  else if a.cls == FInf | b.cls == FInf then inf_bits(f, neg)
  else if a.cls == FZero | b.cls == FZero then zero_bits(f, neg)
  else fround(f, neg, a.mag * b.mag, a.e + b.e)
}

// Total order helper for finite/inf non-NaN values: returns -1, 0, 1. -0 == +0 here.
function fcmp(f : fmt, x : bits(32), y : bits(32)) -> int = {
  let a = fdecode(f, x);
  let b = fdecode(f, y);
  let sa : int = if a.cls == FZero then 0 else if a.neg then -1 else 1;
  let sb : int = if b.cls == FZero then 0 else if b.neg then -1 else 1;
  if sa != sb then (if sa < sb then -1 else 1)
  else if sa == 0 then 0
  else {
    // same sign, both non-zero
    let mag_cmp : int =
      if a.cls == FInf & b.cls == FInf then 0
      else if a.cls == FInf then 1
      else if b.cls == FInf then -1
      else {
        let e = if a.e < b.e then a.e else b.e;
        let av = a.mag * pow2i(a.e - e);
        let bv = b.mag * pow2i(b.e - e);
        if av < bv then -1 else if av > bv then 1 else 0
      };
    if sa > 0 then mag_cmp else 0 - mag_cmp
  }
}

// maxNum / minNum with -0 < +0.
function fp_max(f : fmt, x : bits(32), y : bits(32)) -> bits(32) = {
  let nx = is_nan(f, x);
  let ny = is_nan(f, y);
  if nx & ny then canon_nan(f) else if nx then y else if ny then x
  else {
    let c = fcmp(f, x, y);
    if c > 0 then x else if c < 0 then y
    else (if fdecode(f, x).neg then y else x)
  }
}

function fp_min(f : fmt, x : bits(32), y : bits(32)) -> bits(32) = {
  let nx = is_nan(f, x);
  let ny = is_nan(f, y);
  if nx & ny then canon_nan(f) else if nx then y else if ny then x
  else {
    let c = fcmp(f, x, y);
    if c < 0 then x else if c > 0 then y
    else (if fdecode(f, x).neg then x else y)
  }
}

function fp_neg(f : fmt, x : bits(32)) -> bits(32) =
  if is_nan(f, x) then canon_nan(f)
  else get_slice_int(32, tmod_int(unsigned(x) + pow2i(f.width - 1), pow2i(f.width)), 0)

function fp_abs(f : fmt, x : bits(32)) -> bits(32) =
  if is_nan(f, x) then canon_nan(f)
  else get_slice_int(32, tmod_int(unsigned(x), pow2i(f.width - 1)), 0)

// Signed integer -> float, exact or RNE.
function fp_of_int(f : fmt, v : int) -> bits(32) =
  if v < 0 then fround(f, true, 0 - v, 0) else fround(f, false, v, 0)

// Float -> signed integer of `bits` width: RNE, saturating, NaN -> 0.
function int_of_fp(f : fmt, x : bits(32), nbits : int) -> int = {
  let a = fdecode(f, x);
  let hi = pow2i(nbits - 1) - 1;
  let lo = 0 - pow2i(nbits - 1);
  match a.cls {
    FNaN => 0,
    FZero => 0,
    FInf => if a.neg then lo else hi,
    FFinite => {
      var r : int = 0;
      if a.e >= 0 then r = a.mag * pow2i(a.e) else {
        let d = pow2i(0 - a.e);
        let q = tdiv_int(a.mag, d);
        let rem = a.mag - q * d;
        let half = tdiv_int(d, 2);
        if (rem > half) | (rem == half & tmod_int(q, 2) == 1) then r = q + 1 else r = q
      };
      let s = if a.neg then 0 - r else r;
      if s > hi then hi else if s < lo then lo else s
    }
  }
}

// Format conversion (f16 <-> f32), RNE, NaN canonical.
function fp_convert(src : fmt, dst : fmt, x : bits(32)) -> bits(32) = {
  let a = fdecode(src, x);
  match a.cls {
    FNaN => canon_nan(dst),
    FInf => inf_bits(dst, a.neg),
    FZero => zero_bits(dst, a.neg),
    FFinite => fround(dst, a.neg, a.mag, a.e)
  }
}
