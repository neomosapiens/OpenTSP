; Read after the Yosys export of the default 16-member gate.
(push)
(declare-const original |ras_commit_s|)
(declare-const upset |ras_commit_s|)
(declare-const after_fault |ras_commit_s|)
(declare-const bit_index (_ BitVec 8))
(define-fun storage ((s |ras_commit_s|)) (_ BitVec 198)
    (concat (|ras_commit_n control_word| s) (ite (|ras_commit_n control_parity| s) #b1 #b0)))
(assert (not (|ras_commit_n integrity_bad| original)))
(assert (not (|ras_commit_n power_reset| upset)))
(assert (bvult bit_index (_ bv198 8)))
(assert (= (storage upset) (bvxor (storage original)
    (bvshl (_ bv1 198) ((_ zero_extend 190) bit_index)))))
(assert (|ras_commit_t| upset after_fault))
; An initially publishable attempt can experience the selected single storage upset.
(push)
(assert (|ras_commit_n publish| original))
(check-sat)
(pop)
; No single protected-state or parity-bit upset may write or publish.
; The next edge must latch mandatory service and fence the domain.
(assert (or (not (|ras_commit_n integrity_bad| upset))
            (|ras_commit_n publish| upset) (|ras_commit_n allow_write| upset)
            (not (|ras_commit_n service_required| after_fault))
            (not (|ras_commit_n fenced| after_fault)) (|ras_commit_n active| after_fault)))
(check-sat)
(pop)
; Check the latch independently of how the arbitrary starting state was reached.
(declare-const locked |ras_commit_s|)
(declare-const advanced |ras_commit_s|)
(assert (|ras_commit_n service_required| locked))
(assert (not (|ras_commit_n power_reset| locked)))
(assert (|ras_commit_t| locked advanced))
(assert (or (|ras_commit_n publish| locked) (|ras_commit_n allow_write| locked)
            (not (|ras_commit_n service_required| advanced)) (not (|ras_commit_n fenced| advanced))))
(check-sat)
