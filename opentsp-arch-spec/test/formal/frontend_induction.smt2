; Per-queue transaction conservation. All counts are mathematical integers.
; Let held include the retained first beat, staged include queued host text,
; and lost include rejected input, padding, overflow and reset discards.
; The service step represents one arbitrary prefix. Removing across a parcel
; boundary is excluded by the complete-head guard in parcel_scan.
(set-logic ALL)
(declare-const held Int)
(declare-const staged Int)
(declare-const live Int)
(declare-const retired Int)
(declare-const lost Int)
(declare-const offered Int)
(declare-const cap Int)
(assert (and (> cap 0) (<= 0 live cap) (>= held 0) (>= staged 0)
             (>= lost 0) (>= retired 0) (= offered (+ held staged live retired lost))))
(declare-const incoming Int)
(declare-const admit Bool)
(assert (>= incoming 0))
; First-beat latch, host input, or rejected offer. Incoming units enter one owner.
(define-fun accounted ((h Int) (s Int) (l Int) (r Int) (d Int) (n Int)) Bool
  (and (= (+ h s l r d) n) (<= 0 l cap) (>= h 0) (>= s 0) (>= r 0) (>= d 0)))
(push)
(assert (not (accounted (+ held (ite admit incoming 0)) staged live retired
                        (+ lost (ite admit 0 incoming)) (+ offered incoming))))
(echo "capture")
(check-sat)
(pop)
(push)
(assert (not (accounted 0 (+ staged (ite admit (+ held incoming) 0))
                        live retired (+ lost (ite admit 0 (+ held incoming))) (+ offered incoming))))
(echo "complete-or-discard")
(check-sat)
(pop)
(push)
(assert (not (accounted held (+ staged incoming) live retired lost (+ offered incoming))))
(echo "host-injection")
(check-sat)
(pop)
(declare-const service Int)
(declare-const pad Int)
(assert (and (<= 0 service staged) (<= 0 pad service)))
(define-fun text () Int (- service pad))
(define-fun pushed () Int (ite (< text (- cap live)) text (- cap live)))
(push)
(assert (not (accounted held (- staged service) (+ live pushed) retired
                        (+ lost (- service pushed)) offered)))
(echo "deliver-padding-overflow")
(check-sat)
(pop)
; A complete head leaves once even if a decoded slot reports an error.
; A hold, incomplete parcel, or independent Repeat has removal count zero.
(declare-const parcel Int)
(declare-const fire Bool)
(assert (<= 0 parcel live))
(define-fun popped () Int (ite fire parcel 0))
(push)
(assert (not (accounted held staged (- live popped) (+ retired popped) lost offered)))
(echo "dispatch-or-hold")
(check-sat)
(pop)
(push)
(assert (not (accounted 0 0 0 retired (+ lost held staged live) offered)))
(echo "reset-epoch")
(check-sat)
(pop)
; FIFO identity order at a service boundary. Unique unit IDs, after removal
; of padding/overflow, are partitioned into consumed, IQ, and staged suffix.
(declare-const old (Seq Int))
(declare-const head (Seq Int))
(declare-const keep (Seq Int))
(declare-const transfer (Seq Int))
(declare-const tail (Seq Int))
(assert (= old (seq.++ head keep)))
(push)
(assert (not (= (seq.++ old transfer tail) (seq.++ head (seq.++ keep transfer) tail))))
(echo "fifo-order")
(check-sat)
(pop)
; An abstract ordered DMA port. A legal request consumes the current head
; iff available. For any earlier requests numbering 'prior', induction shows
; grants = min(prior, depth). Illegal directions do not request the port.
(declare-const prior Int)
(declare-const depth Int)
(declare-const req Bool)
(assert (and (>= prior 0) (>= depth 0)))
(define-fun grants () Int (ite (< prior depth) prior depth))
(define-fun next () Int (+ grants (ite (and req (< grants depth)) 1 0)))
(define-fun consumers () Int (+ prior (ite req 1 0)))
(push)
(assert (not (and (= next (ite (< consumers depth) consumers depth))
                  (<= grants next depth) (=> (= grants depth) (= grants next)))))
(echo "ordered-dma-grant")
(check-sat)
(pop)
