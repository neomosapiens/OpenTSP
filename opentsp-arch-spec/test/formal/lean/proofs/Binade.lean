def nativeValue (n : Int) : Int :=
  let k : Int := 0
    let m : Int := n
    let (k, m) : (Int × Int) :=
      (nativeGroup64 (k,m))
    let (k, m) : (Int × Int) :=
      if ((m ≥b 4294967296) : Bool)
      then
        (let m : Int := (Int.tdiv m 4294967296)
        let k : Int := (k +i 32)
        (k, m))
      else (k, m)
    let (k, m) : (Int × Int) :=
      if ((m ≥b 65536) : Bool)
      then
        (let m : Int := (Int.tdiv m 65536)
        let k : Int := (k +i 16)
        (k, m))
      else (k, m)
    let (k, m) : (Int × Int) :=
      if ((m ≥b 256) : Bool)
      then
        (let m : Int := (Int.tdiv m 256)
        let k : Int := (k +i 8)
        (k, m))
      else (k, m)
    let (k, m) : (Int × Int) :=
      if ((m ≥b 16) : Bool)
      then
        (let m : Int := (Int.tdiv m 16)
        let k : Int := (k +i 4)
        (k, m))
      else (k, m)
    let (k, m) : (Int × Int) :=
      if ((m ≥b 4) : Bool)
      then
        (let m : Int := (Int.tdiv m 4)
        let k : Int := (k +i 2)
        (k, m))
      else (k, m)
    if ((m ≥b 2) : Bool)
    then (k +i 1)
    else k

theorem ilog2_native_source (n : Int) : ilog2 n=nativeValue n := by rfl

theorem native_group_1024_bridge (state : ScanState) : nativeGroup1024 state=group1024 state := by
  rcases state with ⟨k,m⟩
  simp only [nativeGroup1024,group1024,scanStep,literal_power_1024,literal_power_2048,literal_power_4096,literal_power_8192]

theorem native_group_512_bridge (state : ScanState) : nativeGroup512 state=group512 state := by
  rcases state with ⟨k,m⟩
  simp only [nativeGroup512,group512,scanStep,literal_power_512,native_group_1024_bridge]

theorem native_group_128_bridge (state : ScanState) : nativeGroup128 state=group128 state := by
  rcases state with ⟨k,m⟩
  simp only [nativeGroup128,group128,scanStep,literal_power_128,literal_power_256,native_group_512_bridge]

theorem native_group_64_bridge (state : ScanState) : nativeGroup64 state=group64 state := by
  rcases state with ⟨k,m⟩
  simp only [nativeGroup64,group64,scanStep,literal_power_64,native_group_128_bridge]

theorem native_value_bridge (n : Int) : nativeValue n=scanValue n := by
  simp only [nativeValue,scanValue,native_group_64_bridge,scanStep,literal_power_2,literal_power_4,literal_power_8,literal_power_16,literal_power_32]

theorem ilog2_source_binding (n : Int) : ilog2 n=scanValue n := by
  rw [ilog2_native_source,native_value_bridge]

theorem scan_value_projection (n : Int) : scanValue n=(scanAll n).1 := by
  unfold scanValue scanAll
  generalize scanStep 2 (scanStep 4 (scanStep 8 (scanStep 16 (scanStep 32 (group64 (0,n)))))) = state
  rcases state with ⟨k,m⟩
  have h : pow2i 1=2 := by decide
  by_cases hg : 2 ≤ m <;> simp [scanStep,h,hg]


def ScanInvariant (n : Int) (state : ScanState) : Prop :=
  0 ≤ state.1 ∧ 1 ≤ state.2 ∧
    state.2*pow2i state.1 ≤ n ∧ n < (state.2+1)*pow2i state.1

theorem scan_initial (n : Int) (hn : 1 ≤ n) : ScanInvariant n (0,n) := by
  have h : pow2i 0=1 := by decide
  simp [ScanInvariant,h]; omega

theorem scan_step_preserves (n shift : Int) (hs : 0 ≤ shift) (state : ScanState)
    (hi : ScanInvariant n state) : ScanInvariant n (scanStep shift state) := by
  rcases state with ⟨k,m⟩
  rcases hi with ⟨hk,hm,hlo,hhi⟩
  dsimp only at hk hm hlo hhi
  have hB := IntervalProofs.pow2i_positive shift hs
  have hS := IntervalProofs.pow2i_positive k hk
  by_cases hg : pow2i shift ≤ m
  · let q := m.tdiv (pow2i shift)
    have hr := LogarithmProofs.nonnegative_tdiv_bounds m (pow2i shift) (by omega) hB
    change 0 ≤ q ∧ 0 ≤ m-q*pow2i shift ∧ m-q*pow2i shift < pow2i shift at hr
    have hq : 1 ≤ q := by
      by_cases hz : q=0
      · rw [hz] at hr; simp at hr; omega
      · omega
    have hL := Int.mul_le_mul_of_nonneg_right (show q*pow2i shift ≤ m by omega) (by omega : 0 ≤ pow2i k)
    have hU := Int.mul_le_mul_of_nonneg_right
      (show m+1 ≤ (q+1)*pow2i shift by
        have he : (q+1)*pow2i shift=q*pow2i shift+pow2i shift := by grobner
        rw [he]; omega) (by omega : 0 ≤ pow2i k)
    have hp := NumericalProofs.pow2i_add_nonnegative k shift hk hs
    have heL : q*(pow2i k*pow2i shift)=(q*pow2i shift)*pow2i k := by grobner
    have heU : (q+1)*(pow2i k*pow2i shift)=((q+1)*pow2i shift)*pow2i k := by grobner
    simp only [scanStep,hg,ite_true]
    change ScanInvariant n (k+shift,q)
    dsimp only [ScanInvariant]
    rw [hp,heL,heU]
    exact ⟨by omega,hq,by omega,by omega⟩
  · simpa [scanStep,hg] using (show ScanInvariant n (k,m) from ⟨hk,hm,hlo,hhi⟩)

/-- If an input is below B squared, one binary shift leaves it below B. -/
theorem scan_step_bound (shift : Int) (hs : 0 ≤ shift) (state : ScanState)
    (hm : 1 ≤ state.2) (hbound : state.2 < pow2i (2*shift)) :
    (scanStep shift state).2 < pow2i shift := by
  rcases state with ⟨k,m⟩
  dsimp only at hm hbound
  have hB := IntervalProofs.pow2i_positive shift hs
  have hp := NumericalProofs.pow2i_add_nonnegative shift shift hs hs
  have he : shift+shift=2*shift := by omega
  rw [he] at hp
  rw [hp] at hbound
  by_cases hg : pow2i shift ≤ m
  · have hr := LogarithmProofs.nonnegative_tdiv_bounds m (pow2i shift) (by omega) hB
    have hlow : m.tdiv (pow2i shift)*pow2i shift ≤ m := by omega
    have hc : m.tdiv (pow2i shift)*pow2i shift < pow2i shift*pow2i shift := by omega
    have hq := Int.lt_of_mul_lt_mul_right hc (by omega : 0 ≤ pow2i shift)
    simpa [scanStep,hg] using hq
  · simpa [scanStep,hg] using (show m < pow2i shift by omega)


theorem scan_step_ok (n shift : Int) (hs : 0 ≤ shift) (state : ScanState)
    (hi : ScanInvariant n state) (hb : state.2 < pow2i (2*shift)) :
    ScanInvariant n (scanStep shift state) ∧
      (scanStep shift state).2 < pow2i shift :=
  ⟨scan_step_preserves n shift hs state hi,scan_step_bound shift hs state hi.2.1 hb⟩

theorem group_1024_ok (n : Int) (state : ScanState)
    (hi : ScanInvariant n state) (hb : state.2 < pow2i 16384) :
    ScanInvariant n (group1024 state) ∧ (group1024 state).2 < pow2i 1024 := by
  rcases state with ⟨k,m⟩
  by_cases hg : pow2i 1024 ≤ m
  · have h0 := scan_step_ok n 8192 (by decide) (k,m) hi hb
    have h1 := scan_step_ok n 4096 (by decide) (scanStep 8192 (k,m)) h0.1 h0.2
    have h2 := scan_step_ok n 2048 (by decide) (scanStep 4096 (scanStep 8192 (k,m))) h1.1 h1.2
    have h3 := scan_step_ok n 1024 (by decide) (scanStep 2048 (scanStep 4096 (scanStep 8192 (k,m)))) h2.1 h2.2
    simpa only [group1024,hg,ite_true] using h3
  · have hm : m < pow2i 1024 := by omega
    simpa only [group1024,hg,ite_false] using And.intro hi hm

theorem group_512_ok (n : Int) (state : ScanState)
    (hi : ScanInvariant n state) (hb : state.2 < pow2i 16384) :
    ScanInvariant n (group512 state) ∧ (group512 state).2 < pow2i 512 := by
  rcases state with ⟨k,m⟩
  by_cases hg : pow2i 512 ≤ m
  · have h0 := group_1024_ok n (k,m) hi hb
    have h1 := scan_step_ok n 512 (by decide) (group1024 (k,m)) h0.1 h0.2
    simpa only [group512,hg,ite_true] using h1
  · have hm : m < pow2i 512 := by omega
    simpa only [group512,hg,ite_false] using And.intro hi hm

theorem group_128_ok (n : Int) (state : ScanState)
    (hi : ScanInvariant n state) (hb : state.2 < pow2i 16384) :
    ScanInvariant n (group128 state) ∧ (group128 state).2 < pow2i 128 := by
  rcases state with ⟨k,m⟩
  by_cases hg : pow2i 128 ≤ m
  · have h0 := group_512_ok n (k,m) hi hb
    have h1 := scan_step_ok n 256 (by decide) (group512 (k,m)) h0.1 h0.2
    have h2 := scan_step_ok n 128 (by decide) (scanStep 256 (group512 (k,m))) h1.1 h1.2
    simpa only [group128,hg,ite_true] using h2
  · have hm : m < pow2i 128 := by omega
    simpa only [group128,hg,ite_false] using And.intro hi hm

theorem group_64_ok (n : Int) (state : ScanState)
    (hi : ScanInvariant n state) (hb : state.2 < pow2i 16384) :
    ScanInvariant n (group64 state) ∧ (group64 state).2 < pow2i 64 := by
  rcases state with ⟨k,m⟩
  by_cases hg : pow2i 64 ≤ m
  · have h0 := group_128_ok n (k,m) hi hb
    have h1 := scan_step_ok n 64 (by decide) (group128 (k,m)) h0.1 h0.2
    simpa only [group64,hg,ite_true] using h1
  · have hm : m < pow2i 64 := by omega
    simpa only [group64,hg,ite_false] using And.intro hi hm

theorem scan_all_binade (n : Int) (hn : 1 ≤ n) (hb : n < pow2i 16384) :
    0 ≤ (scanAll n).1 ∧ pow2i (scanAll n).1 ≤ n ∧
      n < pow2i ((scanAll n).1+1) := by
  have h0 := group_64_ok n (0,n) (scan_initial n hn) hb
  have h1 := scan_step_ok n 32 (by decide) (group64 (0,n)) h0.1 h0.2
  have h2 := scan_step_ok n 16 (by decide) (scanStep 32 (group64 (0,n))) h1.1 h1.2
  have h3 := scan_step_ok n 8 (by decide) (scanStep 16 (scanStep 32 (group64 (0,n)))) h2.1 h2.2
  have h4 := scan_step_ok n 4 (by decide) (scanStep 8 (scanStep 16 (scanStep 32 (group64 (0,n))))) h3.1 h3.2
  have h5 := scan_step_ok n 2 (by decide) (scanStep 4 (scanStep 8 (scanStep 16 (scanStep 32 (group64 (0,n)))))) h4.1 h4.2
  have h6 := scan_step_ok n 1 (by decide) (scanStep 2 (scanStep 4 (scanStep 8 (scanStep 16 (scanStep 32 (group64 (0,n))))))) h5.1 h5.2
  have hi : ScanInvariant n (scanAll n) := h6.1
  have hm : (scanAll n).2 < 2 := by simpa [scanAll,literal_power_1] using h6.2
  rcases hi with ⟨hk,hl,hL,hU⟩
  have hM : (scanAll n).2=1 := by omega
  rw [hM] at hL hU
  have hp := NumericalProofs.pow2i_add_nonnegative (scanAll n).1 1 hk (by decide)
  rw [literal_power_1] at hp
  refine ⟨hk,by simpa using hL,?_⟩
  rw [hp]
  have he : (1+1)*pow2i (scanAll n).1=pow2i (scanAll n).1*2 := by grobner
  rw [he] at hU
  exact hU

theorem ilog2_binade (n : Int) (hn : 1 ≤ n) (hb : n < pow2i 16384) :
    0 ≤ ilog2 n ∧ pow2i (ilog2 n) ≤ n ∧ n < pow2i (ilog2 n+1) := by
  rw [ilog2_source_binding,scan_value_projection]
  exact scan_all_binade n hn hb

end BinadeProofs
