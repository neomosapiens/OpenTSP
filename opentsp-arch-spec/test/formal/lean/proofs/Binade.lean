theorem literal_power_1024 : pow2i 1024 =  := by decide +kernel
theorem literal_power_2048 : pow2i 2048 =  := by decide +kernel
theorem literal_power_4096 : pow2i 4096 =  := by decide +kernel
theorem literal_power_8192 : pow2i 8192 =  := by decide +kernel

