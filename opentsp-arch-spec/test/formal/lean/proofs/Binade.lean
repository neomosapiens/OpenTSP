-- Unbounded integer invariants for the actual nested binary logarithm.
import Proofs.ZivDomains
open Sail Out Out.Functions
set_option autoImplicit false
set_option maxRecDepth 1000000
set_option maxHeartbeats 1000000
set_option exponentiation.threshold 1000000
namespace BinadeProofs

abbrev ScanState := Int × Int

def scanStep (shift : Int) (state : ScanState) : ScanState :=
  let (k,m) := state
  if ((m ≥b pow2i shift) : Bool) then (k+shift,m.tdiv (pow2i shift)) else (k,m)

def group1024 (state : ScanState) : ScanState :=
  let (k,m) := state
  if ((m ≥b pow2i 1024) : Bool) then
    scanStep 1024 (scanStep 2048 (scanStep 4096 (scanStep 8192 (k,m)))) else (k,m)

def group512 (state : ScanState) : ScanState :=
  let (k,m) := state
  if ((m ≥b pow2i 512) : Bool) then scanStep 512 (group1024 (k,m)) else (k,m)

def group128 (state : ScanState) : ScanState :=
  let (k,m) := state
  if ((m ≥b pow2i 128) : Bool) then
    scanStep 128 (scanStep 256 (group512 (k,m))) else (k,m)

def group64 (state : ScanState) : ScanState :=
  let (k,m) := state
  if ((m ≥b pow2i 64) : Bool) then scanStep 64 (group128 (k,m)) else (k,m)

def scanAll (n : Int) : ScanState :=
  scanStep 1 (scanStep 2 (scanStep 4 (scanStep 8 (scanStep 16 (scanStep 32 (group64 (0,n)))))))

def scanValue (n : Int) : Int :=
  let (k,m) := scanStep 2 (scanStep 4 (scanStep 8 (scanStep 16 (scanStep 32 (group64 (0,n))))))
  if ((m ≥b 2) : Bool) then k+1 else k

theorem literal_power_1 : pow2i 1 = 2 := by decide +kernel
theorem literal_power_2 : pow2i 2 = 4 := by decide +kernel
theorem literal_power_4 : pow2i 4 = 16 := by decide +kernel
theorem literal_power_8 : pow2i 8 = 256 := by decide +kernel
theorem literal_power_16 : pow2i 16 = 65536 := by decide +kernel
theorem literal_power_32 : pow2i 32 = 4294967296 := by decide +kernel
theorem literal_power_64 : pow2i 64 = 18446744073709551616 := by decide +kernel
theorem literal_power_128 : pow2i 128 = 340282366920938463463374607431768211456 := by decide +kernel
theorem literal_power_256 : pow2i 256 = 115792089237316195423570985008687907853269984665640564039457584007913129639936 := by decide +kernel
