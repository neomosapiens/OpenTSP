  if ((m ≥b 18446744073709551616) : Bool)
  then
    (let (k, m) : (Int × Int) :=
      (nativeGroup128 (k,m))
    let (k, m) : (Int × Int) :=
      if ((m ≥b 18446744073709551616) : Bool)
      then
        (let m : Int := (Int.tdiv m 18446744073709551616)
        let k : Int := (k +i 64)
