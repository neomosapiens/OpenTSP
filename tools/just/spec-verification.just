# Generated profile vectors and architecture conformance checks.

# Golden vectors of the variant profiles (test/mid_min, fetch_alt, link_tight, c2c_tx_delayed, ref_small, mini_small, ref_slow):
# generated by tools/gen_model_vectors.py and replayed on the model. `just model-test` runs the same step.
# TSP_SIM, default a fresh build. Takes about 8 minutes: run it in the background with a log.
model-vectors-variants:
    #!/usr/bin/env bash
    set -euo pipefail
    source "${OPENTSP_TOOLCHAIN:-$HOME/.local/opt/opentsp-toolchain}/env.sh"
    bash opentsp-arch-spec/tools/model_test.sh vectors-variants

# The ISS against the model on programs of other geometry and structure: the oracle generator on 12 profiles, the ISS in place of the Python
# oracle: `mini` (1 superlane, 256 words), `test/mid_min` (4 superlanes, 4 MEM slices per hemisphere), `test/sl8` (8 superlanes), `test/sl32`
# (32 superlanes, 512 lanes), the MXM structure profiles `test/acc8`, `test/f16_tandem`, `test/fp8_rate2`, `test/one_plane` and `test/mxm_wide`, and the
# three extension profiles `test/ext_bf16`, `test/ref_ext` and `test/mini_ext` (bf16, bfp8, x128). `iss-diff` runs it after its own oracle runs on the
# 20-superlane profiles.
# TSP_SIM, default target/spec/tsp_sim, built by build_sim.sh when absent. ISS_DIFF_PROGRAMS (default 300) random programs per profile.
iss-diff-variants:
    #!/usr/bin/env bash
    set -euo pipefail
    source "${OPENTSP_TOOLCHAIN:-$HOME/.local/opt/opentsp-toolchain}/env.sh"
    sim="${TSP_SIM:-target/spec/tsp_sim}"
    bash tools/ensure_sim.sh "$sim"
    cargo build --release -q -p tsp-iss
    cfg=opentsp-arch-spec/config
    for c in "$cfg/mini.json" "$cfg/test/mid_min.json" "$cfg/test/sl8.json" "$cfg/test/sl32.json" "$cfg/test/acc8.json" "$cfg/test/f16_tandem.json" "$cfg/test/fp8_rate2.json" "$cfg/test/one_plane.json" "$cfg/test/mxm_wide.json" "$cfg/test/ext_bf16.json" "$cfg/test/ref_ext.json" "$cfg/test/mini_ext.json"; do
        python3 opentsp-arch-spec/test/oracle/diff_oracle.py "$sim" "$c" "${ISS_DIFF_PROGRAMS:-${N:-300}}" 1 --impl target/release/tsp-iss
    done

# The golden vectors of the profiles of 8 and 32 superlanes (not frozen files): generated by tools/gen_model_vectors.py on the model, replayed on the
# model (--check) and on the ISS (`tsp-iss vectors`). 11 profiles and 5 SRAM-width runs; the figure of 6 minutes was written when it had 2 profiles and is not re-measured: expect more than that (estimate, not measured; run it in the background with a log).
iss-vectors-superlanes:
    #!/usr/bin/env bash
    set -euo pipefail
    source "${OPENTSP_TOOLCHAIN:-$HOME/.local/opt/opentsp-toolchain}/env.sh"
    sim="${TSP_SIM:-target/spec/tsp_sim}"
    bash tools/ensure_sim.sh "$sim"
    cargo build --release -q -p tsp-iss
    cfg=opentsp-arch-spec/config
    out="$(mktemp -d)"
    trap 'python3 -c "import shutil,sys; shutil.rmtree(sys.argv[1], ignore_errors=True)" "$out"' EXIT
    for c in test/sl8 test/sl32 test/w14 test/w15 test/w16 test/acc8 test/f16_tandem test/fp8_rate2 test/one_plane test/mxm_wide test/c2c_wide; do
        n="$(basename "$c")"
        python3 opentsp-arch-spec/tools/gen_model_vectors.py "$sim" "$cfg/$c.json" "$out/$n.json" | tail -1
        python3 opentsp-arch-spec/tools/gen_model_vectors.py --check "$sim" "$cfg/$c.json" "$out/$n.json" | tail -2
        target/release/tsp-iss vectors "$out/$n.json" --config "$cfg/$c.json" < /dev/null | tail -1
    done
    # The SRAM address width on the ISS (the model runs it in model_test.sh): the last word, the bank bit, IfetchM, Gather, SetSegment, Step.
    for c in ref mini test/w14 test/w15 test/w16; do
        python3 opentsp-arch-spec/test/directed/sram_width.py target/release/tsp-iss "$cfg/$c.json" | tail -1
    done

# The side vector sets (; conformance/model-extra/, outside the freeze set): generated by tools/gen_model_vectors.py --extra, replayed on the
# model (--check) and loaded by the ISS in-process. `just iss-vectors` runs it.
iss-vectors-extra:
    #!/usr/bin/env bash
    set -euo pipefail
    source "${OPENTSP_TOOLCHAIN:-$HOME/.local/opt/opentsp-toolchain}/env.sh"
    sim="${TSP_SIM:-target/spec/tsp_sim}"
    bash tools/ensure_sim.sh "$sim"
    cargo build --release -q -p tsp-iss
    cfg=opentsp-arch-spec/config
    extra=opentsp-arch-spec/conformance/model-extra
    for c in ref mini test/ref_hw test/ref_patrol; do
        n="$(basename "$c")"
        python3 opentsp-arch-spec/tools/gen_model_vectors.py --extra --check "$sim" "$cfg/$c.json" "$extra/$n.json"
        target/release/tsp-iss vectors "$extra/$n.json" --config "$cfg/$c.json"
    done

# The RTL obligation of every golden vector (platform.md 7.1): conformance/rtl/<profile>.json, written by tools/gen_rtl_obligations.py from
# `tsp-iss verify` on each vector, is compared with a fresh run. About 1 minute for both profiles. Regenerate with
# `python3 opentsp-arch-spec/tools/gen_rtl_obligations.py`.
iss-rtl-obligations:
    #!/usr/bin/env bash
    set -euo pipefail
    source "${OPENTSP_TOOLCHAIN:-$HOME/.local/opt/opentsp-toolchain}/env.sh"
    cargo build --release -q -p tsp-iss
    python3 opentsp-arch-spec/tools/gen_rtl_obligations.py --check
